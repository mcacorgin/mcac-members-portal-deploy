{
  "name": "mcac-members-portal",
  "version": "0.1.0",
  "main": "node_modules/next/dist/bin/next",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "package:godaddy": "bash scripts/package-godaddy.sh",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "test:unit": "tsx --test src/lib/attachments/retention.test.ts src/lib/production-readiness.test.ts src/lib/xlsx.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:bootstrap": "tsx src/db/bootstrap-production.ts",
    "db:promote-superadmins": "tsx src/db/promote-initial-superadmins.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:regression": "tsx scripts/run-regression.ts",
    "test:production-runtime": "playwright test --config=playwright.production.config.ts",
    "test:live": "tsx scripts/run-live-regression.ts",
    "test:live:public": "tsx scripts/run-live-regression.ts --public-only"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tsx": "^4.23.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
