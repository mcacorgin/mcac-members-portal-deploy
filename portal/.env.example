# Copy to .env.local for development. Never commit real values (OPS-01).
DATABASE_URL=postgres://localhost:5432/mcac_portal
AUTH_SECRET=generate-with-npx-auth-secret
# AUTH_URL is optional: the app trusts the request host (any dev port works).
# Set it to the canonical HTTPS URL in hosted environments so notification
# links use the correct origin.
# AUTH_URL=https://members.mcac.org.in

# Vercel Cron sends CRON_SECRET to GET /api/jobs/run. An external scheduler
# sends JOBS_SECRET to POST /api/jobs/run. Use separate random values.
CRON_SECRET=generate-a-vercel-cron-secret
JOBS_SECRET=generate-a-separate-random-secret

# Release interface. "polished" is the default. Set "approved" to roll back
# presentation without changing routes, actions, permissions, or data.
MCAC_UI_VARIANT=polished
# Keep the query-string preview switch off in production.
MCAC_UI_PREVIEW=
# LinkedIn OIDC - create the app at developers.linkedin.com under the MCAC
# Company Page.
# AUTH_LINKEDIN_ISSUER is test-only: it points the provider at a mock OIDC
# server for e2e runs and is ignored in production.
# Leave empty to hide the LinkedIn button (email fallback still works).
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Email - console transport is used when RESEND_API_KEY is empty.
# [MCAC DOMAIN - CLIENT TO CONFIRM] for the sender address.
RESEND_API_KEY=
EMAIL_FROM=MCAC Portal <onboarding@localhost>

# Attachment storage: "local" (dev, .uploads dir) or "supabase" (production).
STORAGE_DRIVER=local
SUPABASE_URL=
# Preferred backend credential (starts with sb_secret_). Keep it server-only.
SUPABASE_SECRET_KEY=
# Temporary fallback for projects still using the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Attachment retention is fail-closed. Keep dry-run until MCAC approves the
# final privacy/retention notice, then set to delete in Production only.
ATTACHMENT_RETENTION_MODE=dry-run

# One-time, idempotent production bootstrap. Point PRIVACY_NOTICE_PATH to the
# client-approved final notice on the trusted operator machine. Remove the
# password variable from the shell after the command succeeds.
PRIVACY_NOTICE_PATH=
PRIVACY_NOTICE_VERSION=1
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
